{
  "name": "nsu-sims-playwright",
  "version": "1.0.0",
  "description": "NSU SIMS Portal Playwright End-to-End Automation Suite",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:auth": "playwright test tests/auth.setup.ts",
    "test:gradeditor": "playwright test tests/gradeditor/gradeditor-minor-update.spec.ts",
    "test:gradeditor:headed": "playwright test tests/gradeditor/gradeditor-minor-update.spec.ts --headed",
    "test:supervisor": "playwright test tests/supervisor/parvin-approval.spec.ts",
    "test:supervisor:headed": "playwright test tests/supervisor/parvin-approval.spec.ts --headed",
    "test:controller": "playwright test tests/supervisor/controller-approval.spec.ts",
    "test:controller:headed": "playwright test tests/supervisor/controller-approval.spec.ts --headed",
    "report": "playwright show-report",
    "report:standalone": "playwright test --reporter=html",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "nsu-sims",
    "automation",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}

